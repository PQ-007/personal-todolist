# OAuth 2.0 Web client ID from Google Cloud Console (not secret, but keep it out of git).
# Used as the default; you can override it in the app's Settings.
VITE_GOOGLE_CLIENT_ID=

# OAuth client secret, read only by the sign-in function (netlify/functions/auth.ts) under
# `npx netlify dev`. On Netlify, set it in the site's environment variables instead.
# Never prefix it with VITE_: that would build it into the app.
GOOGLE_CLIENT_SECRET=
